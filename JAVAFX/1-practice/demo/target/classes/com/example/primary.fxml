<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="600.0" prefWidth="1000.0" stylesheets="@styles/styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mainController">
   <left>
      <VBox styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="40.0" prefWidth="270.0" styleClass="logo">
               <children>
                  <Label text="Task" textFill="#030303">
                     <font>
                        <Font size="29.0" />
                     </font>
                  </Label>
                  <Label styleClass="labelFlow" text="Flow" textFill="#030303">
                     <font>
                        <Font size="29.0" />
                     </font>
                  </Label>
               </children>
            </HBox>
            <HBox onMouseClicked="#showDashboard" styleClass="menuItem">
               <children>
                  <Label onMouseClicked="#showDashboard" text="Tablero" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showMyTasks" styleClass="menuItem">
               <children>
                  <Label onMouseClicked="#showMyTasks" text="Mis tareas" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showCalendar" styleClass="menuItem">
               <children>
                  <Label onMouseClicked="#showCalendar" text="Calendario" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showTeam" styleClass="menuItem">
               <children>
                  <Label onMouseClicked="#showTeam" text="Equipo" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showSettings" styleClass="menuItem">
               <children>
                  <Label onMouseClicked="#showSettings" text="Configuración" />
               </children>
            </HBox>
            <Region VBox.vgrow="ALWAYS" />
            <Region styleClass="divisor">
               <VBox.margin>
                  <Insets bottom="15.0" left="-20.0" right="-20.0" />
               </VBox.margin>
            </Region>
            <HBox prefHeight="100.0" prefWidth="200.0" styleClass="contactInfo">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="bubble">
                     <children>
                        <Label text="AR" textFill="WHITE" />
                     </children>
                     <HBox.margin>
                        <Insets left="15.0" right="15.0" />
                     </HBox.margin>
                  </HBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" styleClass="info">
                     <children>
                        <Label text="Alex Rivera" />
                        <Label styleClass="subLabel" text="Administrador" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="800.0" prefWidth="1200.0" styleClass="mainContainer" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="55.0" prefWidth="730.0" styleClass="title">
               <children>
                  <Label prefHeight="55.0" prefWidth="347.0" text="Tablero de Proyectos" />
                  <Region prefHeight="50.0" prefWidth="50.0" HBox.hgrow="ALWAYS" />
                  <TextField accessibleText="Buscar Tarea...." prefHeight="42.0" prefWidth="150.0" promptText="Buscar tareas..." styleClass="search">
                     <HBox.margin>
                        <Insets right="10.0" top="10.0" />
                     </HBox.margin>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </TextField>
                  <Button mnemonicParsing="false" onAction="#showNewTask" styleClass="newTaskButton" text="+ Nueva tarea">
                     <HBox.margin>
                        <Insets left="5.0" right="10.0" top="10.0" />
                     </HBox.margin>
                  </Button>
               </children>
            </HBox>
            <StackPane fx:id="mainContainer" VBox.vgrow="ALWAYS" />
         </children></VBox>
   </center>
</BorderPane>
