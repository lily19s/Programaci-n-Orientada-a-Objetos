<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" stylesheets="@styles/styles.css" xmlns="http://javafx.com/javafx/13" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.mainController">
   <left>
      <VBox prefHeight="400.0" prefWidth="270.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="40.0" prefWidth="200.0" styleClass="logo">
               <children>
                  <Label text="Task" />
                  <Label styleClass="labelFlow" text="Flow" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showDashboard" prefHeight="100.0" prefWidth="200.0" styleClass="menuItem">
               <children>
                  <Label text="Tablero" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showMyTasks" prefHeight="100.0" prefWidth="200.0" styleClass="menuItem">
               <children>
                  <Label text="Mis Tareas" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showCalendar" prefHeight="100.0" prefWidth="200.0" styleClass="menuItem">
               <children>
                  <Label text="Calendario" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showTeam" prefHeight="100.0" prefWidth="200.0" styleClass="menuItem">
               <children>
                  <Label text="Equipo" />
               </children>
            </HBox>
            <HBox onMouseClicked="#showSettings" prefHeight="100.0" prefWidth="200.0" styleClass="menuItem">
               <children>
                  <Label text="Configuración" />
               </children>
            </HBox>
            <Region prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
            <Region prefHeight="200.0" prefWidth="200.0" styleClass="divisor">
               <VBox.margin>
                  <Insets bottom="20.0" left="-15.0" right="-15.0" />
               </VBox.margin>
            </Region>
            <HBox prefHeight="100.0" prefWidth="200.0" styleClass="contactInfo">
               <children>
                  <HBox prefHeight="100.0" prefWidth="200.0" styleClass="bubble">
                     <children>
                        <Label text="AR" />
                     </children>
                     <HBox.margin>
                        <Insets left="15.0" right="15.0" />
                     </HBox.margin>
                  </HBox>
                  <VBox prefHeight="200.0" prefWidth="100.0" styleClass="info">
                     <children>
                        <Label text="Alex Rivera" />
                        <Label styleClass="sublabel" text="Administrador" />
                     </children>
                  </VBox>
               </children>
            </HBox>
         </children>
      </VBox>
   </left>
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" styleClass="mainContainer" BorderPane.alignment="CENTER">
         <children>
            <HBox prefHeight="100.0" prefWidth="200.0" styleClass="header">
               <children>
                  <Label prefHeight="43.0" prefWidth="373.0" text="Tablero de Proyectos" />
                  <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
                  <TextField promptText="Buscar tareas.." styleClass="searchBox">
                     <HBox.margin>
                        <Insets right="20.0" />
                     </HBox.margin>
                  </TextField>
                  <Button mnemonicParsing="false" prefHeight="43.0" styleClass="btn-add" text="+ Nueva Tarea" />
               </children>
            </HBox>
            <StackPane fx:id="mainContainer" prefHeight="150.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
         </children></VBox>
   </center>
